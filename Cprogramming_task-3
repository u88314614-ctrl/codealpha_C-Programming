#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILE_NAME "accounts.dat"
#define TEMP_FILE "temp_accounts.dat"

struct Account {
    int accountNumber;
    char name[50];
    double balance;
};

/* Find an account by account number */
int findAccount(int accountNumber, struct Account *result) {
    FILE *fp = fopen(FILE_NAME, "rb");
    struct Account account;

    if (fp == NULL) {
        return 0;
    }

    while (fread(&account, sizeof(struct Account), 1, fp) == 1) {
        if (account.accountNumber == accountNumber) {
            if (result != NULL) {
                *result = account;
            }

            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

/* Generate a unique account number */
int generateAccountNumber(void) {
    FILE *fp = fopen(FILE_NAME, "rb");
    struct Account account;
    int maxNumber = 1000;

    if (fp == NULL) {
        return maxNumber + 1;
    }

    while (fread(&account, sizeof(struct Account), 1, fp) == 1) {
        if (account.accountNumber > maxNumber) {
            maxNumber = account.accountNumber;
        }
    }

    fclose(fp);

    return maxNumber + 1;
}

/* Create a new account */
void createAccount(void) {
    FILE *fp;
    struct Account account;

    account.accountNumber = generateAccountNumber();

    printf("\nEnter Account Holder Name: ");

    if (scanf(" %49[^\n]", account.name) != 1) {
        printf("Invalid name.\n");
        return;
    }

    printf("Enter Initial Deposit (minimum 0): ");

    if (scanf("%lf", &account.balance) != 1 ||
        account.balance < 0) {
        printf("Invalid amount. Please enter a non-negative amount.\n");
        return;
    }

    fp = fopen(FILE_NAME, "ab");

    if (fp == NULL) {
        printf("Error opening account file.\n");
        return;
    }

    if (fwrite(&account, sizeof(struct Account), 1, fp) == 1) {
        printf("\nAccount created successfully!\n");
        printf("Your Account Number: %d\n", account.accountNumber);
        printf("Account Holder: %s\n", account.name);
        printf("Current Balance: %.2f\n", account.balance);
    } else {
        printf("Error saving account information.\n");
    }

    fclose(fp);
}

/* Deposit money */
void depositMoney(void) {
    FILE *fp = fopen(FILE_NAME, "rb+");
    struct Account account;
    int accountNumber;
    double amount;
    int found = 0;

    if (fp == NULL) {
        printf("\nNo accounts found. Please create an account first.\n");
        return;
    }

    printf("\nEnter Account Number: ");

    if (scanf("%d", &accountNumber) != 1) {
        printf("Invalid account number.\n");
        fclose(fp);
        return;
    }

    while (fread(&account, sizeof(struct Account), 1, fp) == 1) {
        if (account.accountNumber == accountNumber) {
            found = 1;

            printf("Enter Amount to Deposit: ");

            if (scanf("%lf", &amount) != 1 ||
                amount <= 0 ||
                amount > 1000000000.0 - account.balance) {
                printf("Invalid deposit amount.\n");
                fclose(fp);
                return;
            }

            account.balance += amount;

            if (fseek(fp, -(long)sizeof(struct Account), SEEK_CUR) != 0) {
                printf("Error locating account record.\n");
                fclose(fp);
                return;
            }

            if (fwrite(&account, sizeof(struct Account), 1, fp) == 1) {
                printf("\nDeposit successful!\n");
                printf("Updated Balance: %.2f\n", account.balance);
            } else {
                printf("Error updating account balance.\n");
            }

            break;
        }
    }

    if (!found) {
        printf("Account not found.\n");
    }

    fclose(fp);
}

/* Withdraw money */
void withdrawMoney(void) {
    FILE *fp = fopen(FILE_NAME, "rb+");
    struct Account account;
    int accountNumber;
    double amount;
    int found = 0;

    if (fp == NULL) {
        printf("\nNo accounts found. Please create an account first.\n");
        return;
    }

    printf("\nEnter Account Number: ");

    if (scanf("%d", &accountNumber) != 1) {
        printf("Invalid account number.\n");
        fclose(fp);
        return;
    }

    while (fread(&account, sizeof(struct Account), 1, fp) == 1) {
        if (account.accountNumber == accountNumber) {
            found = 1;

            printf("Available Balance: %.2f\n", account.balance);
            printf("Enter Amount to Withdraw: ");

            if (scanf("%lf", &amount) != 1 || amount <= 0) {
                printf("Invalid withdrawal amount.\n");
                fclose(fp);
                return;
            }

            if (amount > account.balance) {
                printf("Insufficient balance!\n");
                fclose(fp);
                return;
            }

            account.balance -= amount;

            if (fseek(fp, -(long)sizeof(struct Account), SEEK_CUR) != 0) {
                printf("Error locating account record.\n");
                fclose(fp);
                return;
            }

            if (fwrite(&account, sizeof(struct Account), 1, fp) == 1) {
                printf("\nWithdrawal successful!\n");
                printf("Remaining Balance: %.2f\n", account.balance);
            } else {
                printf("Error updating account balance.\n");
            }

            break;
        }
    }

    if (!found) {
        printf("Account not found.\n");
    }

    fclose(fp);
}

/* Check account balance */
void balanceEnquiry(void) {
    struct Account account;
    int accountNumber;

    printf("\nEnter Account Number: ");

    if (scanf("%d", &accountNumber) != 1) {
        printf("Invalid account number.\n");
        return;
    }

    if (findAccount(accountNumber, &account)) {
        printf("\n========== BALANCE ENQUIRY ==========\n");
        printf("Account Number: %d\n", account.accountNumber);
        printf("Account Holder: %s\n", account.name);
        printf("Available Balance: %.2f\n", account.balance);
        printf("=====================================\n");
    } else {
        printf("Account not found.\n");
    }
}

/* Display all account records */
void displayAccounts(void) {
    FILE *fp = fopen(FILE_NAME, "rb");
    struct Account account;
    int count = 0;

    if (fp == NULL) {
        printf("\nNo accounts found.\n");
        return;
    }

    printf("\n=============== ACCOUNT LIST ===============\n");
    printf("%-15s %-25s %-15s\n",
           "Account No.", "Account Holder", "Balance");
    printf("-------------------------------------------------------\n");

    while (fread(&account, sizeof(struct Account), 1, fp) == 1) {
        printf("%-15d %-25s %-15.2f\n",
               account.accountNumber,
               account.name,
               account.balance);
        count++;
    }

    fclose(fp);

    if (count == 0) {
        printf("No accounts found.\n");
    } else {
        printf("\nTotal Accounts: %d\n", count);
    }
}

