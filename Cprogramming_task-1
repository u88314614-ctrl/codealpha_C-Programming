#include <stdio.h>

int main() {
float num1, num2, result;
char operator;

// Input two numbers
printf("Enter the first number: ");
scanf("%f", &num1);

printf("Enter the second number: ");
scanf("%f", &num2);

// Input the operation
printf("Enter an operator (+, -, *, /): ");
scanf(" %c", &operator);

// Perform the calculation
switch (operator) {
    case '+':
        result = num1 + num2;
        printf("Result = %.2f\n", result);
        break;

    case '-':
        result = num1 - num2;
        printf("Result = %.2f\n", result);
        break;

    case '*':
        result = num1 * num2;
        printf("Result = %.2f\n", result);
        break;

    case '/':
        if (num2 != 0) {
            result = num1 / num2;
            printf("Result = %.2f\n", result);
        } else {
            printf("Error: Division by zero is not allowed.\n");
        }
        break;

    default:
        printf("Invalid operator! Please use +, -, *, or /.\n");
}

return 0;

}
